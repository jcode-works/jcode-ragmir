{
  "name": "@jcode.labs/ragmir",
  "version": "0.4.12",
  "description": "Open-source retrieval for agentic RAG: local document search, exact citations, OCR, CLI, MCP, and TypeScript.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Jean-Baptiste Thery",
    "url": "https://github.com/jb-thery"
  },
  "keywords": [
    "jcode",
    "ragmir",
    "open-source",
    "rag",
    "agentic-rag",
    "ai-agents",
    "coding-agents",
    "knowledge-base",
    "offline-first",
    "cited-retrieval",
    "local-first",
    "mcp",
    "mcp-server",
    "nodejs",
    "typescript",
    "transformers",
    "semantic-search",
    "lancedb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcode-works/jcode-ragmir.git",
    "directory": "packages/ragmir-core"
  },
  "homepage": "https://github.com/jcode-works/jcode-ragmir#readme",
  "bugs": {
    "url": "https://github.com/jcode-works/jcode-ragmir/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rgr": "dist/cli-entry.js"
  },
  "files": [
    "dist",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench:compare": "node benchmarks/compare.mjs",
    "bench:cli-startup": "pnpm build && node benchmarks/cli-startup.mjs",
    "bench:concurrency": "pnpm build && node benchmarks/concurrency.mjs",
    "bench:discovery": "pnpm build && node benchmarks/discovery.mjs",
    "bench:ingest-memory": "pnpm build && node benchmarks/ingest-memory.mjs",
    "bench:ingestion-metadata": "pnpm build && node benchmarks/ingestion-metadata.mjs",
    "bench:local-hash-runtime": "pnpm build && node benchmarks/local-hash-runtime.mjs",
    "bench:local-hash-experiment": "pnpm build && node benchmarks/local-hash-experiment.mjs",
    "bench:reranker-experiment": "pnpm build && node benchmarks/reranker-experiment.mjs",
    "bench:index-compression-experiment": "pnpm build && node benchmarks/index-compression-experiment.mjs",
    "bench:content-dedup-experiment": "pnpm build && node benchmarks/content-dedup-experiment.mjs",
    "bench:model-lifecycle": "pnpm build && node benchmarks/model-lifecycle.mjs",
    "bench:observability": "pnpm build && node benchmarks/observability.mjs",
    "bench:parsers": "pnpm build && node benchmarks/parsers.mjs",
    "bench:runtime": "pnpm build && node benchmarks/runtime-reuse.mjs",
    "bench:ocr": "pnpm build && node benchmarks/ocr-cache.mjs",
    "bench:generations": "pnpm build && node benchmarks/generation-retention.mjs",
    "bench:quality": "pnpm build && node benchmarks/quality.mjs",
    "bench:scale": "pnpm build && node benchmarks/run.mjs --profile scale",
    "bench:smoke": "pnpm build && node benchmarks/verify.mjs && node benchmarks/run.mjs --profile smoke",
    "bench:storage": "pnpm build && node benchmarks/storage-maintenance.mjs",
    "bench:status": "pnpm build && node benchmarks/status.mjs",
    "bench:vector-index": "pnpm build && node benchmarks/vector-index.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "mcp:smoke": "pnpm build && node scripts/mcp-smoke.mjs",
    "package:check": "publint",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "bench:developer-evidence": "pnpm build && node benchmarks/developer-evidence.mjs"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fflate": "^0.8.3",
    "html-to-text": "^10.0.1",
    "mammoth": "^1.12.3",
    "picocolors": "^1.1.1",
    "read-excel-file": "^9.3.10",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.3",
    "apache-arrow": "^18.1.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
