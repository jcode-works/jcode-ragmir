---
import { defaultLang, getLocalizedUrl, languageTags } from "../i18n/utils"
import Layout from "../layouts/layout.astro"
import { RagmirBackground } from "./ragmir-background"
import RagmirLogo from "./ragmir-logo.astro"

interface ErrorCopy {
  title: string
  metaDescription: string
  message: string
}

interface LocalizedErrorCopy extends ErrorCopy {
  /** Label of the link back to the localized home page. */
  back: string
}

interface Props extends ErrorCopy {
  code: string
  /** The host serves one error page for every locale, so the copy follows the URL path's locale. */
  localized: Record<string, LocalizedErrorCopy>
}

const { code, title, metaDescription, message, localized } = Astro.props
const homeUrl = getLocalizedUrl("/", defaultLang)
---

<Layout
  title={title}
  description={metaDescription}
  locale={defaultLang}
  robots="noindex, follow"
  availableLocales={[]}
>
  <RagmirBackground
    behindContent={false}
    className="inset-x-0 top-0 [mask-image:linear-gradient(to_bottom,black_55%,transparent)]"
    client:visible
    height="300px"
  />

  <main
    class="relative z-10 flex min-h-dvh flex-col items-center justify-center gap-6 px-5 text-center"
  >
    <a aria-label="Ragmir" class="flex items-center" href={homeUrl}>
      <RagmirLogo />
    </a>

    <p class="font-black text-[5rem] text-foreground leading-none md:text-[7rem]">{code}</p>
    <p class="max-w-md text-lg text-muted-foreground" data-i18n="desc">{message}</p>

    <a
      class="rounded-full bg-[var(--primary)] px-6 py-3 font-bold text-[var(--primary-foreground)] text-sm transition-colors hover:bg-[var(--primary-hover)]"
      data-i18n="link"
      href={homeUrl}
    >
      <span data-i18n="btn">Back to Ragmir</span>
    </a>
  </main>

  <script is:inline define:vars={{ localized, languageTags }}>
    ;(() => {
      const prefix = /^\/([a-z]{2})(?:\/|$)/i.exec(location.pathname)?.[1]?.toLowerCase()
      const copy = prefix ? localized[prefix] : undefined
      if (!copy) return
      const desc = document.querySelector('[data-i18n="desc"]')
      const btn = document.querySelector('[data-i18n="btn"]')
      const link = document.querySelector('[data-i18n="link"]')
      const description = document.querySelector('meta[name="description"]')
      if (desc) desc.textContent = copy.message
      if (btn) btn.textContent = copy.back
      if (link) link.setAttribute("href", `/${prefix}/`)
      if (description) description.setAttribute("content", copy.metaDescription)
      document.title = copy.title
      document.documentElement.setAttribute("lang", languageTags[prefix] ?? prefix)
    })()
  </script>
</Layout>
