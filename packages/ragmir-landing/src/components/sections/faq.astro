---
import { getFaqItems } from "../../content/faq"
import { SectionHeader } from "../section-header"

interface Props {
  translations: Record<string, string>
}

const { translations } = Astro.props
const t = (key: string): string => translations[key] ?? key

const faqItems = getFaqItems(translations)
---

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="relative z-10 w-full overflow-hidden py-16 md:py-40"
>
  <div class="container-default px-5 md:px-8">
    <div class="mb-10 md:mb-14">
      <SectionHeader
        num="008"
        label={t("faq_eyebrow")}
        title={t("faq_title")}
        text={t("faq_text")}
        id="faq-heading"
      />
    </div>

    <div class="mx-auto grid max-w-3xl gap-3">
      {faqItems.map((item) => (
        <details class="group rounded-xl bg-card px-5 py-4 transition-colors hover:bg-[#1a1a1a] open:hover:bg-card">
          <summary class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4 font-bold text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
            {item.question}
            <svg
              class="size-4 shrink-0 text-muted-foreground transition-transform duration-300 group-open:rotate-180 motion-reduce:transition-none"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <p class="mt-3 max-w-3xl text-muted-foreground text-sm leading-6">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
