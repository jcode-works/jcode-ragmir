---
import { ArrowDown, ArrowRight, SquareTerminal } from "@lucide/astro"
import { HeroDemo } from "../hero-demo"
import { NpmDownloadCounter } from "../npm-download-counter"
import { RagmirBackground } from "../ragmir-background"
import { INTEGRATION_LOGOS, type IntegrationLogoKey } from "../../content/integration-logos"
import { HERO_DEMO_TRANSLATIONS, pickTranslations } from "../../lib/island-translations"
import { PROJECT_LINKS } from "../../lib/project-links"
import { getMonthlyNpmDownloads } from "../../services/npm-downloads"

interface Props {
  translations: Record<string, string>
  locale: string
  localizedLibraryUrl: string
  localizedUseCasesUrl: string
}

const { translations, locale, localizedLibraryUrl, localizedUseCasesUrl } = Astro.props
const t = (key: string): string => translations[key] ?? key
const monthlyNpmDownloads = await getMonthlyNpmDownloads()

const worksWith: { name: string; logo?: IntegrationLogoKey }[] = [
  { name: "Claude Code", logo: "claude" },
  { name: "Codex" },
  { name: "Cursor", logo: "cursor" },
  { name: "Gemini CLI", logo: "gemini" },
  { name: "LangChain", logo: "langchain" },
  { name: "MCP", logo: "mcp" },
]
const heroTitleLines = [
  t("hero_title_line_1"),
  t("hero_title_line_2"),
  t("hero_title_line_3"),
]
---

<section
  id="top"
  aria-labelledby="hero-heading"
  class="relative z-10 min-h-dvh w-full overflow-hidden"
>
  <RagmirBackground client:load behindContent className="inset-0" height="100%" />

  <div class="container-wide relative z-10 grid min-h-dvh w-full items-center gap-10 px-5 pt-24 pb-28 md:grid-cols-[minmax(0,1fr)_minmax(20rem,1fr)] md:gap-10 md:px-8 lg:content-center lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-14 lg:py-20">
    <div class="min-w-0 max-w-4xl">
      <h1
        id="hero-heading"
        aria-label={t("hero_title")}
        class="hero-title-outline display-title max-w-3xl text-2xl font-black leading-[1.06] text-white sm:text-3xl lg:text-4xl"
      >
        {heroTitleLines.map((line) => <span class="block">{line}</span>)}
      </h1>
      <p class="text-shadow-hero mt-5 max-w-xl text-xs font-medium leading-5 text-white sm:text-sm sm:leading-6">
        {t("hero_description")}
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          class="inline-flex h-14 items-center justify-center gap-2 rounded-full bg-primary px-8 text-sm font-bold text-primary-foreground transition hover:bg-[var(--primary-hover)]"
          href={localizedLibraryUrl}
        >
          {t("hero_primary_cta")}
          <ArrowRight class="size-4" />
        </a>
        <a
          class="inline-flex h-14 items-center justify-center gap-2 rounded-full bg-card px-8 text-sm font-bold text-white transition-colors hover:bg-[#1f1f1f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          href={localizedUseCasesUrl}
        >
          {t("hero_secondary_cta")}
        </a>
      </div>
      {monthlyNpmDownloads !== null && (
        <div class="text-shadow-hero mt-3">
          <NpmDownloadCounter
            client:idle
            downloads={monthlyNpmDownloads}
            label={t("hero_npm_downloads_label")}
            locale={locale}
          />
        </div>
      )}
      <p class="text-shadow-hero mt-3 max-w-xl text-xs leading-5 text-white/85">
        <strong class="font-black text-white">{t("hero_proof_recall_value")}</strong>
        {` ${t("hero_proof_recall_label")} · `}
        <strong class="font-black text-white">{t("hero_proof_speed_value")}</strong>
        {` ${t("hero_proof_speed_label")}. `}
        <a
          class="font-semibold text-white underline underline-offset-2 transition-colors hover:text-[var(--accent-title)]"
          href={PROJECT_LINKS.benchmarks}
        >
          {t("hero_proof_link")}
        </a>
      </p>
      <div class="text-shadow-hero mt-8 max-w-xl">
        <p class="text-white/70 text-xs font-semibold">{t("hero_works_with")}</p>
        <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-3" role="list">
          {worksWith.map((item) => {
            const logo = item.logo ? INTEGRATION_LOGOS[item.logo] : undefined
            return (
              <li>
                <a
                  class="inline-flex items-center gap-2 text-sm font-semibold text-white/90 transition-colors hover:text-white"
                  href="#integrations"
                >
                  {logo ? (
                    <svg class="size-4" viewBox="0 0 24 24" fill={logo.color ?? "currentColor"} aria-hidden="true">
                      <path d={logo.path} />
                    </svg>
                  ) : (
                    <SquareTerminal class="size-4" aria-hidden="true" />
                  )}
                  {item.name}
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    </div>

    <div class="flex min-w-0 w-full flex-col gap-3 md:justify-self-end">
      <HeroDemo
        client:visible
        translations={pickTranslations(translations, HERO_DEMO_TRANSLATIONS)}
      />
    </div>

    <nav
      class="pointer-events-none absolute inset-x-0 bottom-6 z-20 h-8 lg:bottom-8"
      aria-label={t("hero_scroll_aria_nav")}
    >
      <a
        class="pointer-events-auto absolute left-1/2 top-0 inline-flex size-8 -translate-x-1/2 items-center justify-center rounded-full text-white/70 transition-colors duration-200 hover:text-white focus-visible:outline-none motion-reduce:transition-none"
        href="#use-cases"
        aria-label={t("hero_scroll_aria_link")}
      >
        <ArrowDown class="scroll-hint size-3.5" />
      </a>
    </nav>
  </div>
</section>
