---
import { ArrowUpRight } from "@lucide/astro"
import { PROJECT_LINKS } from "../../lib/project-links"
import { cardTag, SectionHeader } from "../section-header"

interface Props {
  translations: Record<string, string>
}

const { translations } = Astro.props
const t = (key: string): string => translations[key] ?? key

const deployItems = [
  { title: t("deploy_item_1_title"), text: t("deploy_item_1_text") },
  { title: t("deploy_item_2_title"), text: t("deploy_item_2_text") },
  { title: t("deploy_item_3_title"), text: t("deploy_item_3_text") },
  { title: t("deploy_item_4_title"), text: t("deploy_item_4_text") },
]
---

<section
  id="deploy"
  aria-labelledby="deploy-heading"
  class="container-default relative z-10 px-5 py-16 md:px-8 md:py-40"
>
  <div class="mb-10 md:mb-14">
    <SectionHeader
      num="005"
      label={t("deploy_eyebrow")}
      title={t("deploy_title")}
      text={t("deploy_text")}
      id="deploy-heading"
    />
  </div>

  <ol
    class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 scroll-px-5 overscroll-x-contain [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-3 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4 [&::-webkit-scrollbar]:hidden"
    aria-label={t("deploy_title")}
    tabindex="0"
  >
    {deployItems.map((item, index) => (
      <li class="flex w-[78vw] max-w-[20rem] shrink-0 snap-start flex-col rounded-xl bg-card p-5 sm:w-auto sm:max-w-none md:p-6">
        <div class="flex items-start justify-between">
          <span class="tnum font-mono text-[10px] text-muted-foreground tracking-[0.25em]">
            {cardTag(index + 1, deployItems.length)}
          </span>
          <span aria-hidden="true" class="size-1.5 rounded-full bg-foreground/30" />
        </div>
        <h3 class="mt-8 font-black text-lg leading-snug">{item.title}</h3>
        <p class="mt-2 text-muted-foreground text-sm leading-6">{item.text}</p>
      </li>
    ))}
  </ol>

  <div class="mt-3 flex flex-col gap-3 rounded-xl bg-card p-4 md:flex-row md:items-center md:justify-between md:px-6">
    <p class="flex flex-col gap-1 text-sm sm:flex-row sm:items-baseline sm:gap-3">
      <span class="font-bold">{t("deploy_owns_label")}</span>
      <span class="font-mono text-foreground/75 text-xs">{t("deploy_owns_items")}</span>
    </p>
    <a
      class="inline-flex h-10 w-fit shrink-0 items-center gap-2 rounded-full bg-background px-4 text-sm font-bold text-foreground transition-colors hover:bg-[var(--inset-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:scale-[0.98] motion-reduce:transform-none"
      href={PROJECT_LINKS.serverGuide}
    >
      {t("deploy_guide_link")}
      <ArrowUpRight class="size-4" aria-hidden="true" />
    </a>
  </div>
</section>
