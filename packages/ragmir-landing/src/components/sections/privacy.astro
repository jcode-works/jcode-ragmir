---
import { cardTag, SectionHeader } from "../section-header"

interface Props {
  translations: Record<string, string>
}

const { translations } = Astro.props
const t = (key: string): string => translations[key] ?? key

const privacyControls = [
  { title: t("privacy_docs_title"), text: t("privacy_docs_text") },
  { title: t("privacy_index_title"), text: t("privacy_index_text") },
  { title: t("privacy_selection_title"), text: t("privacy_selection_text") },
  { title: t("privacy_consumer_title"), text: t("privacy_consumer_text") },
]
---

<section
  class="container-default relative z-10 px-5 py-16 md:px-8 md:py-40"
  aria-labelledby="privacy-heading"
>
  <div class="mb-10 md:mb-14">
    <SectionHeader
      num="007"
      label={t("privacy_eyebrow")}
      title={t("privacy_title")}
      text={t("privacy_text")}
      id="privacy-heading"
    />
  </div>

  <ol
    class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 scroll-px-5 overscroll-x-contain [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4 lg:gap-4 [&::-webkit-scrollbar]:hidden"
    aria-label={t("privacy_title")}
    tabindex="0"
  >
    {privacyControls.map((control, index) => (
      <li class="flex w-[78vw] max-w-[20rem] shrink-0 snap-start flex-col rounded-xl bg-card p-5 sm:w-auto sm:max-w-none md:p-6">
        <div class="flex items-start justify-between">
          <span class="tnum font-mono text-[10px] text-muted-foreground tracking-[0.25em]">
            {cardTag(index + 1, privacyControls.length)}
          </span>
          <span aria-hidden="true" class="size-1.5 rounded-full bg-foreground/30" />
        </div>
        <h3 class="mt-8 font-black text-lg leading-snug">{control.title}</h3>
        <p class="mt-2 text-muted-foreground text-sm leading-6">{control.text}</p>
      </li>
    ))}
  </ol>
</section>
