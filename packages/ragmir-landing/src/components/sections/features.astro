---
import {
  Bot,
  Library,
  ScanText,
  Quote,
  SearchCheck,
  ShieldCheck,
  FileText,
  WifiOff,
} from "@lucide/astro"
import { CommandCopyBox } from "../command-copy"
import { RagmirBackground } from "../ragmir-background"
import { cardTag, SectionHeader } from "../section-header"

interface Props {
  translations: Record<string, string>
}

const { translations } = Astro.props
const t = (key: string): string => translations[key] ?? key

const featureGroups = [
  {
    icon: Library,
    title: t("features_core_title"),
    badge: t("features_core_badge"),
    installCommand: "npm install -D @jcode.labs/ragmir",
    command: "npx rgr setup",
    text: t("features_core_text"),
    items: [
      { icon: SearchCheck, text: t("features_core_item_1") },
      { icon: Quote, text: t("features_core_item_2") },
      { icon: Bot, text: t("features_core_item_3") },
      { icon: ShieldCheck, text: t("features_core_item_4") },
    ],
  },
  {
    icon: FileText,
    title: t("features_ocr_title"),
    badge: t("features_optional_badge"),
    installCommand: "npx rgr ocr doctor",
    command: "npx rgr ocr setup --language eng+fra",
    text: t("features_ocr_text"),
    items: [
      { icon: FileText, text: t("features_ocr_item_1") },
      { icon: Quote, text: t("features_ocr_item_2") },
      { icon: WifiOff, text: t("features_ocr_item_3") },
      { icon: ShieldCheck, text: t("features_ocr_item_4") },
    ],
  },
  {
    icon: ScanText,
    title: t("features_semantic_title"),
    badge: t("features_optional_badge"),
    installCommand: "npm install -D @huggingface/transformers",
    command: "npx rgr setup --semantic",
    text: t("features_semantic_text"),
    items: [
      { icon: ScanText, text: t("features_semantic_item_1") },
      { icon: Quote, text: t("features_semantic_item_2") },
      { icon: WifiOff, text: t("features_semantic_item_3") },
      { icon: Bot, text: t("features_semantic_item_4") },
    ],
  },
]
---

<section
  id="features"
  aria-labelledby="features-heading"
  class="relative z-10 w-full overflow-hidden py-16 md:py-40"
>
  <RagmirBackground client:visible behindContent className="inset-0" height="100%" />

  <div class="container-default px-5 md:px-8">
    <div class="mb-10 md:mb-14">
      <SectionHeader
        num="006"
        label={t("features_eyebrow")}
        title={t("features_title")}
        text={t("features_text")}
        id="features-heading"
      />
    </div>

    <div
      class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 scroll-px-5 overscroll-x-contain [scrollbar-width:none] md:-mx-8 md:px-8 md:scroll-px-8 lg:mx-0 lg:grid lg:auto-rows-fr lg:grid-cols-3 lg:gap-4 lg:overflow-visible lg:px-0 lg:pb-0 [&::-webkit-scrollbar]:hidden"
      role="region"
      aria-label={t("features_title")}
      tabindex="0"
    >
      {featureGroups.map((group, index) => (
        <article class="grid h-full w-[86vw] max-w-[24rem] shrink-0 snap-start grid-rows-[auto_auto_auto_auto_1fr] rounded-xl lg:w-auto lg:max-w-none bg-card p-5 text-card-foreground md:p-6">
          <div class="flex items-center justify-between gap-3">
            <span class="tnum font-mono text-[10px] text-muted-foreground tracking-[0.25em]">
              {cardTag(index + 1, featureGroups.length)}
            </span>
            <span class="rounded-full bg-background px-3 py-1 font-semibold text-muted-foreground text-xs">
              {group.badge}
            </span>
          </div>
          <h3 class="mt-8 font-black text-xl leading-tight">{group.title}</h3>
          <p class="mt-3 min-h-12 text-muted-foreground text-sm leading-6">{group.text}</p>
          <div class="mt-5 grid gap-3">
            <div class="min-h-[5.25rem]">
              <p class="mb-2 font-mono text-[10px] text-muted-foreground uppercase tracking-[0.25em]">
                {t("features_install_label")}
              </p>
              <CommandCopyBox
                client:visible
                command={group.installCommand}
                copyLabel={t("copy_command")}
              />
            </div>
            <div class="min-h-[5.25rem]">
              <p class="mb-2 font-mono text-[10px] text-muted-foreground uppercase tracking-[0.25em]">
                {t("features_run_label")}
              </p>
              <CommandCopyBox
                client:visible
                command={group.command}
                copyLabel={t("copy_command")}
              />
            </div>
          </div>
          <ul class="mt-7 grid content-start gap-3">
            {group.items.map((item) => (
              <li class="flex gap-3 text-sm leading-6">
                <item.icon class="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
                <span class="text-foreground/88">{item.text}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
