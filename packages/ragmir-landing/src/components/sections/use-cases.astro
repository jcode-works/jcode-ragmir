---
import { pickTranslations, USE_CASE_TRANSLATIONS } from "../../lib/island-translations"
import { SectionHeader } from "../section-header"
import { UseCaseCarousel } from "../use-case-carousel"

interface Props {
  translations: Record<string, string>
}

const { translations } = Astro.props
const t = (key: string): string => translations[key] ?? key

---

<section
  id="use-cases"
  aria-labelledby="use-cases-heading"
  class="container-default relative z-10 px-5 py-16 md:px-8 md:py-40"
>
  <div class="mb-10 md:mb-14">
    <SectionHeader
      num="001"
      label={t("use_cases_eyebrow")}
      title={t("use_cases_title")}
      text={t("use_cases_text")}
      id="use-cases-heading"
    />
  </div>

  <UseCaseCarousel
    client:visible
    translations={pickTranslations(translations, USE_CASE_TRANSLATIONS)}
  />
</section>
