---
import { ArrowUp, ArrowUpRight } from "@lucide/astro"
import { CommandCopyBox } from "../command-copy"
import { cardTag, SectionHeader } from "../section-header"
import { GITHUB_URL } from "../../lib/project-links"

interface Props {
  translations: Record<string, string>
}

const { translations } = Astro.props
const t = (key: string): string => translations[key] ?? key

const operatingModes = [
  { name: t("agents_full_local_name"), text: t("agents_full_local_text") },
  { name: t("agents_self_hosted_name"), text: t("agents_self_hosted_text") },
  { name: t("agents_connected_name"), text: t("agents_connected_text") },
]
---

<section
  id="agents"
  aria-labelledby="agents-heading"
  class="container-default relative z-10 px-5 py-16 md:px-8 md:py-40"
>
  <div class="mb-10 md:mb-14">
    <SectionHeader
      num="004"
      label={t("agents_eyebrow")}
      title={t("agents_title")}
      text={t("agents_text")}
      id="agents-heading"
    />
  </div>

  <div class="grid gap-3 lg:grid-cols-2 lg:gap-4">
    <div class="rounded-xl bg-card p-5 md:p-6">
      <h3 class="font-black text-lg">{t("agents_command_label")}</h3>
      <div class="mt-4">
        <CommandCopyBox client:visible command={t("agents_command")} copyLabel={t("copy_command")} />
      </div>
      <p class="mt-5 text-muted-foreground text-sm">{t("agents_plugin_label")}</p>
      <div class="mt-2">
        <CommandCopyBox
          client:visible
          command={t("agents_plugin_command")}
          copyLabel={t("copy_command")}
        />
      </div>
      <a
        class="mt-4 inline-flex h-10 w-fit shrink-0 items-center gap-2 rounded-full bg-background px-4 text-sm font-bold text-foreground transition-colors hover:bg-[var(--inset-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:scale-[0.98] motion-reduce:transform-none"
        href="#integrations"
      >
        {t("agents_plugin_more")}
        <ArrowUp class="size-4" aria-hidden="true" />
      </a>
    </div>

    <div class="flex flex-col rounded-xl bg-card p-5 md:p-6">
      <h3 class="font-black text-lg">{t("agents_model_title")}</h3>
      <p class="mt-3 text-muted-foreground text-sm leading-6">{t("agents_model_text")}</p>
      <div class="mt-auto pt-5">
        <a
          class="inline-flex h-10 w-fit shrink-0 items-center gap-2 rounded-full bg-background px-4 text-sm font-bold text-foreground transition-colors hover:bg-[var(--inset-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:scale-[0.98] motion-reduce:transform-none"
          href={`${GITHUB_URL}/blob/main/docs/agent-integration.md`}
        >
          {t("agents_model_link")}
          <ArrowUpRight class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <div class="mt-12 md:mt-16">
    <h3 class="font-black text-xl md:text-2xl">{t("agents_targets_title")}</h3>
    <p class="mt-2 max-w-2xl text-muted-foreground text-sm leading-6">{t("agents_targets_text")}</p>
    <ol class="mt-6 grid gap-3 md:grid-cols-3 md:gap-4">
      {operatingModes.map((mode, index) => (
        <li class="flex flex-col rounded-xl bg-card p-5 md:p-6">
          <div class="flex items-start justify-between">
            <span class="tnum font-mono text-[10px] text-muted-foreground tracking-[0.25em]">
              {cardTag(index + 1, operatingModes.length)}
            </span>
            <span aria-hidden="true" class="size-1.5 rounded-full bg-foreground/30" />
          </div>
          <h4 class="mt-8 font-black text-lg">{mode.name}</h4>
          <p class="mt-2 text-muted-foreground text-sm leading-6">{mode.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
