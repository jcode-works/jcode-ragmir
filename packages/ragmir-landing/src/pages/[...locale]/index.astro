---
import { CommandCopyToast } from "../../components/command-copy-toast"
import { FloatingCta } from "../../components/floating-cta"
import { LibrarySection } from "../../components/library-section"
import { LandingNavbar } from "../../components/landing-navbar"
import { RagmirBackground } from "../../components/ragmir-background"
import Agents from "../../components/sections/agents.astro"
import ClosingCta from "../../components/sections/closing-cta.astro"
import Deploy from "../../components/sections/deploy.astro"
import Faq from "../../components/sections/faq.astro"
import Features from "../../components/sections/features.astro"
import Footer from "../../components/sections/footer.astro"
import Hero from "../../components/sections/hero.astro"
import Integrations from "../../components/sections/integrations.astro"
import Privacy from "../../components/sections/privacy.astro"
import UseCases from "../../components/sections/use-cases.astro"
import { defaultLang, getLocalizedUrl, languages, locales, useTranslations } from "../../i18n/utils"
import Layout from "../../layouts/layout.astro"
import {
  LIBRARY_TRANSLATIONS,
  NAVBAR_TRANSLATIONS,
  pickTranslations,
} from "../../lib/island-translations"
import { PROJECT_LINKS } from "../../lib/project-links"

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLang ? undefined : locale },
  }))
}

const locale = (Astro.params.locale as string | undefined) ?? defaultLang
const { t, translations } = await useTranslations(locale)
const alternateLocales = locales.map((entry) => ({
  locale: entry,
  label: languages[entry],
  href: getLocalizedUrl("/", entry),
}))
const siteUrl = new URL("/", Astro.site ?? "https://ragmir.com").href
const pageUrl = new URL(getLocalizedUrl("/", locale), Astro.site ?? "https://ragmir.com").href
const publicVersion = import.meta.env.PUBLIC_RAGMIR_VERSION?.trim()
const sourceDescription =
  "The open-source retrieval layer for agentic RAG: document search with exact citations on a laptop, a VPS, or an offline server, through TypeScript, CLI, and MCP. Your agent reasons and acts with your choice of model."
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://ragmir.com/#organization",
    name: "JCode Labs",
    url: "https://github.com/jcode-works",
    founder: {
      "@type": "Person",
      "@id": "https://ragmir.com/#jb-thery",
      name: "Jean-Baptiste Thery",
      url: "https://github.com/jb-thery",
      sameAs: ["https://github.com/jb-thery"],
    },
    knowsAbout: [
      "local-first retrieval",
      "agentic RAG workflows",
      "cited document search",
      "Model Context Protocol",
      "AI agent tooling",
      "Node.js RAG library",
      "self-hosted RAG deployment",
    ],
    sameAs: ["https://github.com/jcode-works"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://ragmir.com/#website",
    url: siteUrl,
    name: "Ragmir",
    description: sourceDescription,
    inLanguage: ["en", "fr"],
    publisher: { "@id": "https://ragmir.com/#organization" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    "@id": "https://ragmir.com/#source",
    name: "Ragmir",
    description: sourceDescription,
    abstract: sourceDescription,
    url: siteUrl,
    inLanguage: ["en", "fr"],
    codeRepository: PROJECT_LINKS.github,
    codeSampleType: "full solution",
    runtimePlatform: "Node.js 22.12 or later on Linux (x64 or ARM64, glibc or musl), macOS, and Windows",
    programmingLanguage: "TypeScript",
    keywords: [
      "agentic RAG",
      "local RAG",
      "self-hosted RAG",
      "coding agents",
      "cited retrieval",
      "MCP",
      "MCP server",
      "Claude Code plugin",
      "Codex plugin",
      "Cursor plugin",
      "Gemini CLI extension",
      "Qwen Code extension",
      "LangChain.js retriever",
      "TypeScript",
      "AGPL open source",
    ],
    license: PROJECT_LINKS.license,
    usageInfo: PROJECT_LINKS.commercialLicense,
    isAccessibleForFree: true,
    ...(publicVersion ? { version: publicVersion } : {}),
    isPartOf: {
      "@id": "https://ragmir.com/#website",
    },
    sameAs: [
      PROJECT_LINKS.github,
      PROJECT_LINKS.npm,
    ],
    publisher: {
      "@id": "https://ragmir.com/#organization",
    },
    author: {
      "@id": "https://ragmir.com/#jb-thery",
    },
    maintainer: {
      "@id": "https://ragmir.com/#jb-thery",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: t("seo_home_title"),
    description: t("seo_home_description"),
    inLanguage: locale,
    isPartOf: { "@id": "https://ragmir.com/#website" },
    about: { "@id": "https://ragmir.com/#source" },
    publisher: { "@id": "https://ragmir.com/#organization" },
  },
]
const localizedHomeUrl = `${getLocalizedUrl("/", locale)}#top`
const localizedLibraryUrl = `${getLocalizedUrl("/", locale)}#library`
const localizedFeaturesUrl = `${getLocalizedUrl("/", locale)}#features`
const localizedUseCasesUrl = `${getLocalizedUrl("/", locale)}#use-cases`
const localizedAgentsUrl = `${getLocalizedUrl("/", locale)}#agents`
const localizedDeployUrl = `${getLocalizedUrl("/", locale)}#deploy`
const localizedFaqUrl = `${getLocalizedUrl("/", locale)}#faq`
const localizedTeamUrl = getLocalizedUrl("/team", locale)
---

<Layout
  title={t("seo_home_title")}
  description={t("seo_home_description")}
  author={t("seo_author")}
  robots={t("seo_robots")}
  ogImageAlt={t("seo_image_alt")}
  locale={locale}
  availableLocales={locales}
  structuredData={structuredData}
>
  <main class="relative min-h-screen overflow-hidden bg-background text-foreground">
    <LandingNavbar
      client:load
      alternateLocales={alternateLocales}
      locale={locale}
      currentPath={Astro.url.pathname}
      localizedAgentsUrl={localizedAgentsUrl}
      localizedDeployUrl={localizedDeployUrl}
      localizedFaqUrl={localizedFaqUrl}
      localizedFeaturesUrl={localizedFeaturesUrl}
      localizedHomeUrl={localizedHomeUrl}
      localizedLibraryUrl={localizedLibraryUrl}
      localizedTeamUrl={localizedTeamUrl}
      localizedUseCasesUrl={localizedUseCasesUrl}
      translations={pickTranslations(translations, NAVBAR_TRANSLATIONS)}
    />

    <Hero
      translations={translations}
      locale={locale}
      localizedLibraryUrl={localizedLibraryUrl}
      localizedUseCasesUrl={localizedUseCasesUrl}
    />

    <UseCases translations={translations} />

    <LibrarySection
      client:visible
      translations={pickTranslations(translations, LIBRARY_TRANSLATIONS)}
    />

    <Integrations translations={translations} />

    <div class="relative isolate overflow-hidden">
      <div aria-hidden="true" class="absolute inset-0">
        <RagmirBackground client:visible behindContent={false} height="100%" />
      </div>
      <Agents translations={translations} />
    </div>

    <Deploy translations={translations} />

    <Features translations={translations} />

    <Privacy translations={translations} />

    <Faq translations={translations} />

    <ClosingCta translations={translations} localizedLibraryUrl={localizedLibraryUrl} />

    <Footer
      localizedHomeUrl={localizedHomeUrl}
      translations={translations}
    />

    <CommandCopyToast client:idle message={t("command_copied")} />

    <FloatingCta client:idle href={localizedLibraryUrl} label={t("hero_primary_cta")} />
  </main>
</Layout>
