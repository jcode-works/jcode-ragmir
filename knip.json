{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreBinaries": ["mise", "textutil"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/public-api-consumer/consumer.ts"],
      "project": ["scripts/**/*.mjs", "tests/**/*.ts"]
    },
    "packages/ragmir-core": {
      "entry": ["benchmarks/*.mjs", "scripts/*.mjs", "examples/**/*.{mjs,ts}"],
      "project": ["src/**/*.ts", "benchmarks/**/*.mjs", "scripts/**/*.mjs"]
    },
    "packages/ragmir-landing": {
      "ignoreDependencies": ["@astrojs/check"]
    }
  }
}
