{
  "name": "jcode-ragmir",
  "version": "0.4.12",
  "private": true,
  "description": "Open-source retrieval for agentic RAG: local document search, exact citations, OCR, CLI, MCP, and TypeScript.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Jean-Baptiste Thery (https://github.com/jb-thery)",
  "homepage": "https://github.com/jcode-works/jcode-ragmir#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcode-works/jcode-ragmir.git"
  },
  "bugs": {
    "url": "https://github.com/jcode-works/jcode-ragmir/issues"
  },
  "keywords": [
    "ragmir",
    "rag",
    "agentic-rag",
    "local-rag",
    "mcp",
    "ai-agents",
    "coding-agents",
    "nodejs",
    "typescript",
    "offline-first",
    "cited-retrieval",
    "local-first",
    "knowledge-base"
  ],
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "api:check": "tsc -p tests/public-api-consumer/tsconfig.json",
    "bootstrap": "mise install && pnpm install",
    "bench:compare": "pnpm --filter @jcode.labs/ragmir bench:compare",
    "bench:cli-startup": "pnpm --filter @jcode.labs/ragmir bench:cli-startup",
    "bench:discovery": "pnpm --filter @jcode.labs/ragmir bench:discovery",
    "bench:ingest-memory": "pnpm --filter @jcode.labs/ragmir bench:ingest-memory",
    "bench:ingestion-metadata": "pnpm --filter @jcode.labs/ragmir bench:ingestion-metadata",
    "bench:local-hash-runtime": "pnpm --filter @jcode.labs/ragmir bench:local-hash-runtime",
    "bench:local-hash-experiment": "pnpm --filter @jcode.labs/ragmir bench:local-hash-experiment",
    "bench:reranker-experiment": "pnpm --filter @jcode.labs/ragmir bench:reranker-experiment",
    "bench:index-compression-experiment": "pnpm --filter @jcode.labs/ragmir bench:index-compression-experiment",
    "bench:content-dedup-experiment": "pnpm --filter @jcode.labs/ragmir bench:content-dedup-experiment",
    "bench:observability": "pnpm --filter @jcode.labs/ragmir bench:observability",
    "bench:parsers": "pnpm --filter @jcode.labs/ragmir bench:parsers",
    "bench:generations": "pnpm --filter @jcode.labs/ragmir bench:generations",
    "bench:quality": "pnpm --filter @jcode.labs/ragmir bench:quality",
    "bench:runtime": "pnpm --filter @jcode.labs/ragmir bench:runtime",
    "bench:scale": "pnpm --filter @jcode.labs/ragmir bench:scale",
    "bench:smoke": "pnpm --filter @jcode.labs/ragmir bench:smoke",
    "bench:storage": "pnpm --filter @jcode.labs/ragmir bench:storage",
    "bench:status": "pnpm --filter @jcode.labs/ragmir bench:status",
    "bench:vector-index": "pnpm --filter @jcode.labs/ragmir bench:vector-index",
    "audit:security": "pnpm audit --audit-level moderate",
    "build": "pnpm --filter @jcode.labs/ragmir-landing build && pnpm --filter @jcode.labs/ragmir build",
    "check": "pnpm --filter @jcode.labs/ragmir-landing check && pnpm --filter @jcode.labs/ragmir check",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "dev:landing": "pnpm --filter @jcode.labs/ragmir-landing dev",
    "example": "pnpm --filter @jcode.labs/ragmir build && node packages/ragmir-core/examples/library-api-demo/run.mjs",
    "format": "biome format --write .",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "license:check": "node scripts/license-policy-smoke.mjs",
    "offline:smoke": "node scripts/offline-install-smoke.mjs",
    "package:check": "pnpm --filter @jcode.labs/ragmir package:check",
    "public:smoke": "node scripts/public-surface-smoke.mjs && pnpm license:check",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "release:semantic:smoke": "node scripts/semantic-release-smoke.mjs",
    "smoke": "pnpm public:smoke && node scripts/smoke.mjs && pnpm --filter @jcode.labs/ragmir mcp:smoke",
    "test": "pnpm --filter @jcode.labs/ragmir-landing test && pnpm --filter @jcode.labs/ragmir test",
    "test:coverage": "pnpm --filter @jcode.labs/ragmir-landing test:coverage && pnpm --filter @jcode.labs/ragmir test:coverage",
    "validate": "pnpm lint && pnpm audit:security && pnpm check && pnpm test:coverage && pnpm build && pnpm api:check && pnpm smoke && pnpm package:check && pnpm release:semantic:smoke && pnpm release:artifacts",
    "bench:developer-evidence": "pnpm --filter @jcode.labs/ragmir bench:developer-evidence"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/exec": "^7.1.0",
    "@vitest/coverage-v8": "5.0.1",
    "semantic-release": "^25.0.9",
    "yaml": "^2.9.1"
  }
}
